# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the transaction pooler (port 6543) connection string for serverless/pooled access.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# Supabase project URL and API keys.
# Dashboard -> Project Settings -> API Keys (create new keys if you only see legacy anon/service_role).
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_[...]"
SUPABASE_SECRET_KEY="sb_secret_[...]"

# HTTP port the backend listens on (optional; defaults to 8787).
PORT=8787

# Runtime environment: development | test | production (optional; defaults to development).
NODE_ENV=development

# Origin allowed to call this API via CORS — the Next.js frontend (optional; defaults to http://localhost:3000).
CORS_ORIGIN=http://localhost:3000

# You can also place these variables in the repo root `.env.local` — the backend loads that file on startup.

# Cursor Supabase MCP (optional — not used by the backend runtime):
# Create a personal access token at https://supabase.com/dashboard/account/tokens
# and set SUPABASE_ACCESS_TOKEN in the repo root `.env.local` for `.cursor/mcp.json`.
