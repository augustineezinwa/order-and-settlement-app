# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the transaction pooler (port 6543) connection string for serverless/pooled access.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# Supabase project URL and anon key (Auth).
# Supabase Dashboard -> Project Settings -> API.
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[ANON_KEY]"

# HTTP port the backend listens on (optional; defaults to 8787).
PORT=8787

# Runtime environment: development | test | production (optional; defaults to development).
NODE_ENV=development
